# ==============================================================================
# FOUNDER VOICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env.local' and supply your API keys:
#   cp env.local.template .env.local

# 1. OpenAI API Key (REQUIRED)
# Powers the VC Persona reasoning (gpt-4o-mini) and the post-pitch Fundability Report (gpt-4o)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 2. Deepgram API Key (REQUIRED)
# Powers real-time STT (Nova-2 audio stream) and TTS voice playback (Aura Orion)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=...

# (Optional) Deepgram Project ID: If your API key does not have admin permissions to create ephemeral keys,
# you can leave this empty and the system will fallback automatically to your primary key.
# DEEPGRAM_PROJECT_ID=...

# 3. Supabase Configuration (REQUIRED)
# Powers authentication and database storage (profiles, pitch_decks, sessions)
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 4. Tavily API Key (RECOMMENDED)
# Powers real-time web search for fact-checking competitor claims during the pitch
# https://tavily.com/
TAVILY_API_KEY=tvly-...

# 5. Groq API Key (OPTIONAL)
# Used only if the secondary real-time logic-guard check endpoint is enabled
# https://console.groq.com/
GROQ_API_KEY=gsk_...
